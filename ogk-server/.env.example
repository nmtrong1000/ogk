OGK_DATABASE_URL=sqlite+aiosqlite:///./data/ogk.db
OGK_TLS_CERT=certs/out/server.crt
OGK_TLS_KEY=certs/out/server.key
OGK_HOST=0.0.0.0
OGK_PORT=8443
OGK_DASHBOARD_DIST=../ogk-dashboard/dist
# Sinh bằng: python -m app.cli gen-data-key
OGK_DATA_KEY=
