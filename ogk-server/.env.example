# Copy to .env and fill in.
# OGK_DATA_KEY: generate with python -m app.cli gen-data-key
# OGK_POLICY_SIGNING_KEY: Ed25519 private key that signs policies; generate with python -m app.cli gen-policy-key.
# The file must be chmod 600. Give certs/out/policy_public.pem to the agent installer.
# OGK_SEED_PASSWORD: development only; password of every account created by python -m app.cli seed-dev.
# OGK_TRUSTED_PROXIES: comma-separated proxy IPs whose X-Forwarded-For header is trusted (default 127.0.0.1,::1)
OGK_DATABASE_URL=sqlite+aiosqlite:///./data/ogk.db
OGK_TLS_CERT=certs/out/server.crt
OGK_TLS_KEY=certs/out/server.key
OGK_HOST=0.0.0.0
OGK_PORT=8443
OGK_DASHBOARD_DIST=../ogk-dashboard/dist
OGK_DATA_KEY=
OGK_TRUSTED_PROXIES=127.0.0.1,::1
OGK_POLICY_SIGNING_KEY=certs/out/policy_signing.pem
OGK_SEED_PASSWORD=
