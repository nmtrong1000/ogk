# Docker settings for docker-compose.yml. Copy to .env next to it and fill in OGK_DATA_KEY.
# OGK_DATA_KEY: generate with `python -m app.cli gen-data-key` in ogk-server. Losing it makes encrypted data
# (children names, audit values) unreadable.
# The policy signing key is created in OGK_CERT_DIR with `python -m app.cli gen-policy-key` in ogk-server.
# OGK_CERT_DIR is a host path; the other paths are inside the container and are mount targets, so the
# database URL must live under OGK_CONTAINER_DATA_DIR.
# OGK_PORT is published on the host with the same number; agents must use it in config.json server_url.
# ogk-server/.env is only for running the server directly on the Mac; Docker never reads it.
# OGK_SEED_PASSWORD: development only. Password of every account created by
# `docker compose exec server python -m app.cli seed-dev`; leave empty on a real deployment.
OGK_DATA_KEY=
OGK_HOST=0.0.0.0
OGK_PORT=8443
OGK_TRUSTED_PROXIES=127.0.0.1,::1
OGK_CERT_DIR=./ogk-server/certs/out
OGK_CONTAINER_DATA_DIR=/data
OGK_DATABASE_URL=sqlite+aiosqlite:////data/ogk.db
OGK_TLS_CERT=/certs/server.crt
OGK_TLS_KEY=/certs/server.key
OGK_CA_CERT=/certs/ca.crt
OGK_DASHBOARD_DIST=/dashboard
OGK_POLICY_SIGNING_KEY=/certs/policy_signing.pem
OGK_SEED_PASSWORD=
OGK_REPORT_TZ=Asia/Ho_Chi_Minh
